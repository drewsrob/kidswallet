{
  "name": "kidswallet",
  "version": "1.0.0",
  "description": "Taschengeld-Verwaltung für Kinder",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -n API,VITE -c cyan,magenta \"node --watch server.js\" \"vite\"",
    "dev:api": "node --watch server.js",
    "dev:client": "vite",
    "build": "vite build",
    "build:android": "cross-env BUILD_TARGET=android vite build",
    "android:sync": "node scripts/android.mjs sync",
    "android:build": "node scripts/android.mjs build",
    "android:release": "node scripts/android.mjs release",
    "android:install": "node scripts/android.mjs install",
    "android:run": "node scripts/android.mjs run",
    "preview": "vite preview",
    "start": "node server.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "compression": "^1.8.1",
    "express": "^4.19.2",
    "i18next": "^27.2.9",
    "sharp": "^0.34.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "vite": "^8.0.3",
    "vite-plugin-pwa": "^2.0.0"
  }
}
